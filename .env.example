# ============================================================
# Risco360 — Variáveis de ambiente
# ============================================================
# Copie este arquivo para .env.local e preencha os valores.
# .env.local não deve ser versionado.
# ============================================================

# Modo mock (desenvolvimento local sem Supabase)
# true  → App funciona offline sem servidor (login automático)
# false → App exige Supabase real com login e senha
# Em produção, usar VITE_ENABLE_MOCK_MODE=false
VITE_ENABLE_MOCK_MODE=true

# Supabase (obrigatório apenas se VITE_ENABLE_MOCK_MODE=false)
# Crie um projeto em https://supabase.com e copie os valores abaixo
# VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# VITE_SUPABASE_ANON_KEY=SUA_ANON_KEY_PUBLICA

# !!! SEGURANÇA !!!
# Nunca usar service_role, sb_secret ou qualquer chave secreta no frontend.
# Apenas a anon key (pública) deve ser usada no navegador.
